        "smithy.api#sensitive": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/so.namespace.private.devbox#UpdateTemplateRequestExperimental/members/claudeApiKey/traits",
      "value": {
        "smithy.api#sensitive": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/so.namespace.private.devbox#ClaudeIntegrationSpec/members/claudeApiKey/traits",
