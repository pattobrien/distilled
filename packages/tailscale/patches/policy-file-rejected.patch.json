{
  "description": "Type setPolicyFile's and previewRuleMatches's 400 as PolicyFileRejected, with its body typed, instead of the spec's message-only BadRequest, so callers keep the per-source findings. A rejected policy file's 400 body is {message, data: [{user, errors, warnings}] | null}: tailscale/tailscale client/tailscale/acl.go (3ec5be3f5) decodes every non-200 from POST /tailnet/{tailnet}/acl as ACLTestError{message, data []ACLTestFailureSummary} with user, errors and warnings omitempty and data not; tailscale-client-go-v2 client.go (9b68d9333) decodes every API error as APIError{message, data []APIErrorData{user, errors}}; the spec's /acl/validate 200 documents the same {message, data: [{user, errors | warnings}]} shape. Every 400 on these operations takes the class, since a body matcher cannot test for the data array; data is optional.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#PolicyFileFindingMessageList",
      "value": {
        "type": "list",
        "member": {
          "target": "smithy.api#String"
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#PolicyFileFinding",
      "value": {
        "type": "structure",
        "members": {
          "user": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The `src` of the failing test."
            }
          },
          "errors": {
            "target": "com.tailscale.api#PolicyFileFindingMessageList"
          },
          "warnings": {
            "target": "com.tailscale.api#PolicyFileFindingMessageList"
          }
        },
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#PolicyFileFindingList",
      "value": {
        "type": "list",
        "member": {
          "target": "com.tailscale.api#PolicyFileFinding"
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#PolicyFileRejectedBody",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {}
            }
          },
          "data": {
            "target": "com.tailscale.api#PolicyFileFindingList",
            "traits": {
              "com.distilled.openapi#nullable": {},
              "smithy.api#documentation": "The errors and warnings per test source."
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#PolicyFileRejected",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "smithy.api#documentation": "Tailscale rejected the policy file (HTTP 400): it does not parse, is invalid, or fails its own tests. `body.data` lists the errors and warnings per test source.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 400
            }
          ]
        }
      }
    },
    {
      "op": "test",
      "path": "/shapes/com.tailscale.api#SetPolicyFile/errors/0",
      "value": {
        "target": "com.tailscale.api#BadRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.tailscale.api#SetPolicyFile/errors/0",
      "value": {
        "target": "com.tailscale.api#PolicyFileRejected"
      }
    },
    {
      "op": "test",
      "path": "/shapes/com.tailscale.api#SetPolicyFile/traits/distilled.errors#bodies/0/status",
      "value": 400
    },
    {
      "op": "replace",
      "path": "/shapes/com.tailscale.api#SetPolicyFile/traits/distilled.errors#bodies/0/target",
      "value": "com.tailscale.api#PolicyFileRejectedBody"
    },
    {
      "op": "test",
      "path": "/shapes/com.tailscale.api#PreviewRuleMatches/errors/0",
      "value": {
        "target": "com.tailscale.api#BadRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.tailscale.api#PreviewRuleMatches/errors/0",
      "value": {
        "target": "com.tailscale.api#PolicyFileRejected"
      }
    },
    {
      "op": "test",
      "path": "/shapes/com.tailscale.api#PreviewRuleMatches/traits/distilled.errors#bodies/0/status",
      "value": 400
    },
    {
      "op": "replace",
      "path": "/shapes/com.tailscale.api#PreviewRuleMatches/traits/distilled.errors#bodies/0/target",
      "value": "com.tailscale.api#PolicyFileRejectedBody"
    }
  ]
}
