{
  "description": "A service account API token's `last_seen_at` is null until the token is first used: the create response's example is null, which left the property with no type, and GET /v3/me returned `\"last_seen_at\": null` live on 2026-10-13. `expires_at` is optional on create, and a token created without it \"will remain valid indefinitely\", so the token has no expiry to report.",
  "patches": [
    {
      "op": "replace",
      "path": "/paths/~1v3~1workplace~1service_accounts~1service_account~1{service_account}~1tokens/post/responses/200/content/application~1json/schema/properties/api_token/properties/last_seen_at",
      "value": { "type": ["string", "null"] }
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1workplace~1service_accounts~1service_account~1{service_account}~1tokens/get/responses/200/content/application~1json/schema/properties/api_tokens/items/properties/last_seen_at/type",
      "value": ["string", "null"]
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1workplace~1service_accounts~1service_account~1{service_account}~1tokens~1token~1{api_token}/get/responses/200/content/application~1json/schema/properties/api_token/properties/last_seen_at/type",
      "value": ["string", "null"]
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1workplace~1service_accounts~1service_account~1{service_account}~1tokens/post/responses/200/content/application~1json/schema/properties/api_token/properties/expires_at/type",
      "value": ["string", "null"]
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1workplace~1service_accounts~1service_account~1{service_account}~1tokens/get/responses/200/content/application~1json/schema/properties/api_tokens/items/properties/expires_at/type",
      "value": ["string", "null"]
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1workplace~1service_accounts~1service_account~1{service_account}~1tokens~1token~1{api_token}/get/responses/200/content/application~1json/schema/properties/api_token/properties/expires_at/type",
      "value": ["string", "null"]
    }
  ]
}
